# 예시 파일입니다. Spring Boot가 .env를 자동 로드하지 않습니다.
# 필요한 값은 셸 또는 IDE의 환경 변수로 전달하세요.
# 빈 프로필은 비웹 모드입니다. HTTP 데모는 demo를 명시해야 활성화됩니다.
SPRING_PROFILES_ACTIVE=
SERVER_PORT=8080

# 향후 구현 예시: 현재 아래 변수는 바인딩하거나 사용하지 않습니다.
# 실제 비밀 값/운영 주소를 이 파일에 넣지 마세요.
# ELASTICSEARCH_URL=
# PAGEINDEX_ENDPOINT=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# DOCUMENT_STORE_URL=
# OIDC_ISSUER_URI=
# OTEL_EXPORTER_OTLP_ENDPOINT=
